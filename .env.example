# Public address of the site — used for links in emails
BASE_URL=https://inspireministries.net
PORT=3000

# First admin account (only used the first time the site starts, when there are no admins yet)
ADMIN_EMAIL=inspireministries24@gmail.com
ADMIN_PASSWORD=change-me-please
ADMIN_NAME=Joel Byers

# Email delivery (SMTP). Example for Gmail: smtp.gmail.com, port 465, an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=inspireministries24@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM=inspireministries24@gmail.com

# Where the SQLite database is stored — must be on a persistent disk in production
DATA_DIR=./data
# Time zone used for dates in the admin portal
TIMEZONE=America/Chicago
