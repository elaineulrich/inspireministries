<%- include('partials/header') %>

<section class="tagline-band"><%- include('partials/tagline') %></section>

<section class="apply-block">
  <h1 class="icon-heading">
    <svg viewBox="0 0 496 512" width="22" height="22" aria-hidden="true"><path fill="#ca0902" d="M336.5 160C322 70.7 287.8 8 248 8s-74 62.7-88.5 152h177zM152 256c0 22.2 1.2 43.5 3.3 64h185.3c2.1-20.5 3.3-41.8 3.3-64s-1.2-43.5-3.3-64H155.3c-2.1 20.5-3.3 41.8-3.3 64zm324.7-96c-28.6-67.9-86.5-120.4-158-141.6 24.4 33.8 41.2 84.7 50 141.6h108zM177.2 18.4C105.8 39.6 47.8 92.1 19.3 160h108c8.7-56.9 25.5-107.8 49.9-141.6zM487.4 192H372.7c2.1 21 3.3 42.5 3.3 64s-1.2 43-3.3 64h114.6c5.5-20.5 8.6-41.8 8.6-64s-3.1-43.5-8.5-64zM120 256c0-21.5 1.2-43 3.3-64H8.6C3.2 212.5 0 233.8 0 256s3.2 43.5 8.6 64h114.6c-2-21-3.2-42.5-3.2-64zm39.5 96c14.5 89.3 48.7 152 88.5 152s74-62.7 88.5-152h-177zm159.3 141.6c71.4-21.2 129.4-73.7 158-141.6h-108c-8.8 56.9-25.6 107.8-50 141.6zM19.3 352c28.6 67.9 86.5 120.4 158 141.6-24.4-33.8-41.2-84.7-50-141.6h-108z"/></svg>
    Online Student Application
  </h1>
  <a class="btn" href="/student-application-online">Fill out a Student Application Online</a>
  <div class="note">
    <p><strong>For Online Application PLEASE NOTE:</strong></p>
    <p>After you sign your application, your parent and pastor can complete and sign their reference forms <strong>in person on your phone</strong>, or we can <strong>email</strong> the forms to the addresses you provide.<br>
    Your progress is saved as you go, so you can come back and finish your application at any time.<br>
    Please allow time for those references to be completed. Once all required references have been submitted, a member of the Inspire Ministries board will then follow up with you regarding the status of your application.</p>
    <p>If you have any questions, please contact <%= settings.contact_name %> at <strong><%= settings.contact_email %></strong> or <strong><%= settings.contact_phone %></strong>.</p>
  </div>
</section>

<section class="apply-block apply-block-alt">
  <div class="arrow-divider" aria-hidden="true"></div>
  <h2 class="icon-heading">
    <svg viewBox="0 0 640 512" width="22" height="22" aria-hidden="true"><path fill="#1e293b" d="M537.6 226.6c4.1-10.7 6.4-22.4 6.4-34.6 0-53-43-96-96-96-19.7 0-38.1 6-53.3 16.2C367 64.2 315.3 32 256 32c-88.4 0-160 71.6-160 160 0 2.7.1 5.4.2 8.1C40.2 219.8 0 273.2 0 336c0 79.5 64.5 144 144 144h368c70.7 0 128-57.3 128-128 0-61.9-44-113.6-102.4-125.4zm-132.9 88.7L299.3 420.7c-6.2 6.2-16.4 6.2-22.6 0L171.3 315.3c-10.1-10.1-2.9-27.3 11.3-27.3H248V176c0-8.8 7.2-16 16-16h48c8.8 0 16 7.2 16 16v112h65.4c14.2 0 21.4 17.2 11.3 27.3z"/></svg>
    Download Student Application
  </h2>
  <div class="download-grid">
    <a class="btn-download" href="/docs/student-application-form.pdf" target="_blank" rel="noopener"><span>1. Download Student Application Form</span><%- include('partials/file-icon') %></a>
    <a class="btn-download" href="/docs/pastoral-reference-form.pdf" target="_blank" rel="noopener"><span>3. Download Pastoral Reference Form</span><%- include('partials/file-icon') %></a>
    <a class="btn-download" href="/docs/parental-reference-form.pdf" target="_blank" rel="noopener"><span>2. Download Parental Reference Form</span><%- include('partials/file-icon') %></a>
    <a class="btn-download" href="/docs/2026-schedule.pdf" target="_blank" rel="noopener"><span>4. Download Informational Form</span><%- include('partials/file-icon') %></a>
  </div>
  <div class="note">
    <p><strong>For Downloaded Application PLEASE NOTE:</strong></p>
    <p>Please download the Student, Parental, and Pastoral forms to fill out. Once the forms have been completed and signed, please email to <strong><%= settings.contact_email %></strong> or give directly to <%= settings.contact_name %> to submit your application.<br>
    Once your application has been submitted, a member of the Inspire Ministries board will then follow up with you regarding the status of your application.</p>
    <p>If you have any questions, please contact <%= settings.contact_name %> at <strong><%= settings.contact_email %></strong> or <strong><%= settings.contact_phone %></strong>.</p>
  </div>
</section>

<%- include('partials/quote', { variant: 'center', image: '/img/praying-hands.jpg', text: 'Hebrews 13:20-21: "Now may the God of peace… equip you with everything good for doing his will, and may he work in us what is pleasing to him, through Jesus Christ".' }) %>

<%- include('partials/footer') %>
