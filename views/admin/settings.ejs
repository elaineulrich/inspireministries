<%- include('_top') %>
<div class="page-head"><h1>Settings</h1></div>
<% if (flash === 'saved') { %><p class="callout callout-ok">Settings saved.</p><% } %>

<form method="post" action="/admin/settings" class="settings">
  <div class="card">
    <h2>Where applications are sent</h2>
    <div class="field">
      <label class="field-label" for="notification_emails">Notification email addresses</label>
      <textarea id="notification_emails" name="notification_emails" rows="2"><%= values.notification_emails %></textarea>
      <p class="field-help">These addresses get an email when a student submits an application and again when all references are complete. Separate several addresses with commas.</p>
    </div>
    <label class="b-check"><input type="checkbox" name="auto_send_references" <%= values.auto_send_references === '1' ? 'checked' : '' %>> Automatically email the parent and pastor reference forms when a student submits</label>
    <p class="field-help">Students can always send (or re-send) them from their status page, or have them filled out in person on their phone.</p>
  </div>

  <div class="card">
    <h2>Applications</h2>
    <label class="b-check"><input type="checkbox" name="accepting_applications" <%= values.accepting_applications === '1' ? 'checked' : '' %>> Accepting new online applications</label>
    <div class="field">
      <label class="field-label" for="closed_message">Message shown when applications are closed</label>
      <textarea id="closed_message" name="closed_message" rows="2"><%= values.closed_message %></textarea>
    </div>
  </div>

  <div class="card">
    <h2>Contact details</h2>
    <p class="field-help">Shown on the website and in the footer of every email.</p>
    <div class="fields">
      <div class="field half"><label class="field-label" for="contact_name">Contact name</label><input id="contact_name" name="contact_name" value="<%= values.contact_name %>"></div>
      <div class="field half"><label class="field-label" for="contact_phone">Contact phone</label><input id="contact_phone" name="contact_phone" value="<%= values.contact_phone %>"></div>
      <div class="field half"><label class="field-label" for="contact_email">Contact email</label><input id="contact_email" name="contact_email" type="email" value="<%= values.contact_email %>"></div>
    </div>
  </div>

  <div class="card">
    <h2>Email sending</h2>
    <div class="fields">
      <div class="field half"><label class="field-label" for="email_from_name">"From" name</label><input id="email_from_name" name="email_from_name" value="<%= values.email_from_name %>"></div>
      <div class="field half"><label class="field-label" for="reply_to">Reply-to address</label><input id="reply_to" name="reply_to" type="email" value="<%= values.reply_to %>"></div>
    </div>
    <% if (smtp) { %>
      <p class="callout callout-ok">Email delivery is connected.</p>
    <% } else { %>
      <p class="callout callout-bad"><strong>Email delivery is not connected yet.</strong> Emails are recorded in the Email Log but not delivered. Set the <code>RESEND_API_KEY</code> and <code>MAIL_FROM</code> environment variables on the server (see README) to start sending.</p>
    <% } %>
    <p class="field-help">Links in emails point to <strong><%= baseUrl %></strong> (set with the <code>BASE_URL</code> environment variable).</p>
  </div>

  <div class="sticky-save"><button class="btn btn-primary" type="submit">Save settings</button></div>
</form>

<form method="post" action="/admin/settings/test-email" class="card">
  <h2>Send a test email</h2>
  <p class="field-help">Sends a test message to your own admin email (<%= admin.email %>).</p>
  <button class="btn btn-ghost" type="submit">Send test email</button>
</form>
<%- include('_bottom') %>
